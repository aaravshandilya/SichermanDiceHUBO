"""
Sicherman Dice using NEC Vector Annealing
=========================================

This version:

1. Restricts the solution space to nontrivial Sicherman dice.
2. Loads a cached QUBO before building the symbolic HUBO.
3. Uses NEC one-hot constraints and valid one-hot initial states.
4. Tries several seeds and stops as soon as an exact solution is found.
5. Accepts optional command-line settings for reproducible experiments.

Examples:

    python3.8 VALibUseSicherman
    python3.8 VALibUseSicherman --seed 137
    python3.8 VALibUseSicherman --seed 137 --attempts 5
    python3.8 VALibUseSicherman --attempts 1 --sweeps 500
"""

from collections import Counter
import argparse
import os
import pickle
import random
import sys
import tempfile
import time

try:
    from pyqubo import Binary
except ImportError as exc:
    raise SystemExit(
        "PyQUBO is not available.\n"
        "Load the NEC/BasePy environment before running this program."
    ) from exc

try:
    import VectorAnnealing
except ImportError as exc:
    raise SystemExit(
        "The NEC VectorAnnealing module is not available.\n"
        "Load the Vector Annealing module before running this program."
    ) from exc


# ======================================================================
# Model parameters
# ======================================================================

N_FACES = 6

# Die A is restricted to 1 through 4. This makes an ordinary die containing
# labels 5 and 6 impossible while preserving [1, 2, 2, 3, 3, 4].
VMAX_A = 4
VMAX_B = 11

VALUES_A = range(1, VMAX_A + 1)
VALUES_B = range(1, VMAX_B + 1)

ONE_HOT_PENALTY = 150.0
REDUCTION_STRENGTH = 1000.0

DEFAULT_NUM_READS = 5
DEFAULT_NUM_RESULTS = 5
DEFAULT_NUM_SWEEPS = 1000
DEFAULT_MAX_ATTEMPTS = 3
NUM_THREADS = -1

BETA_RANGE = [10.0, 100.0, 200]

# Increment this whenever the Hamiltonian formulation changes.
CACHE_VERSION = 2
CACHE_SIGNATURE = {
    "version": CACHE_VERSION,
    "n_faces": N_FACES,
    "vmax_a": VMAX_A,
    "vmax_b": VMAX_B,
    "one_hot_penalty": ONE_HOT_PENALTY,
    "reduction_strength": REDUCTION_STRENGTH,
}

QUBO_CACHE_FILE = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    (
        f".sicherman_qubo_cache_v{CACHE_VERSION}"
        f"_a{VMAX_A}_b{VMAX_B}.pkl"
    ),
)


# ======================================================================
# Command-line options
# ======================================================================

def positive_integer(value):
    """Parse a strictly positive command-line integer."""

    parsed_value = int(value)

    if parsed_value < 1:
        raise argparse.ArgumentTypeError("value must be at least 1")

    return parsed_value


def parse_arguments():
    parser = argparse.ArgumentParser(
        description="Find Sicherman dice using NEC Vector Annealing."
    )

    parser.add_argument(
        "--seed",
        type=int,
        default=None,
        help=(
            "Base random seed. If omitted, a new random seed is chosen "
            "for each program run."
        ),
    )

    parser.add_argument(
        "--attempts",
        type=positive_integer,
        default=DEFAULT_MAX_ATTEMPTS,
        help="Maximum number of different seeds to try.",
    )

    parser.add_argument(
        "--reads",
        type=positive_integer,
        default=DEFAULT_NUM_READS,
        help="NEC annealing reads per attempt.",
    )

    parser.add_argument(
        "--results",
        type=positive_integer,
        default=DEFAULT_NUM_RESULTS,
        help="NEC results returned per attempt.",
    )

    parser.add_argument(
        "--sweeps",
        type=positive_integer,
        default=DEFAULT_NUM_SWEEPS,
        help="NEC sweeps per read.",
    )

    arguments = parser.parse_args()

    if arguments.results > arguments.reads:
        parser.error("--results cannot be greater than --reads")

    return arguments


ARGS = parse_arguments()

if ARGS.seed is None:
    BASE_SEED = random.SystemRandom().randrange(1, 2_000_000_000)
else:
    BASE_SEED = ARGS.seed


# ======================================================================
# Target distribution and variable names
# ======================================================================

def standard_dice_distribution():
    """Return the sum distribution of two ordinary six-sided dice."""

    target = Counter()

    for value_a in range(1, 7):
        for value_b in range(1, 7):
            target[value_a + value_b] += 1

    return dict(target)


TARGET = standard_dice_distribution()


def variable_a(face, value):
    return f"A_{face}_{value}"


def variable_b(face, value):
    return f"B_{face}_{value}"


ORIGINAL_VARIABLE_NAMES = {
    variable_a(face, value)
    for face in range(N_FACES)
    for value in VALUES_A
}

ORIGINAL_VARIABLE_NAMES.update(
    variable_b(face, value)
    for face in range(N_FACES)
    for value in VALUES_B
)


# ======================================================================
# QUBO cache and compilation
# ======================================================================

def load_cached_qubo():
    """Load a compatible cached QUBO, or return None."""

    try:
        with open(QUBO_CACHE_FILE, "rb") as cache_file:
            cached_data = pickle.load(cache_file)

        if cached_data.get("signature") != CACHE_SIGNATURE:
            print("Ignoring QUBO cache because its parameters do not match.")
            return None

        print(f"Loaded cached QUBO: {QUBO_CACHE_FILE}")

        return cached_data["qubo"], cached_data["offset"]

    except FileNotFoundError:
        return None

    except Exception as cache_error:
        print("Ignoring unreadable QUBO cache:", cache_error)
        return None


def build_symbolic_hamiltonian():
    """Build the face-label HUBO only when no cached QUBO is available."""

    x = {
        (face, value): Binary(variable_a(face, value))
        for face in range(N_FACES)
        for value in VALUES_A
    }

    y = {
        (face, value): Binary(variable_b(face, value))
        for face in range(N_FACES)
        for value in VALUES_B
    }

    distribution_objective = 0
    maximum_sum = VMAX_A + VMAX_B

    for total in range(2, maximum_sum + 1):
        expected_count = TARGET.get(total, 0)
        observed_count = 0

        for value_a in VALUES_A:
            value_b = total - value_a

            if value_b not in VALUES_B:
                continue

            for face_a in range(N_FACES):
                for face_b in range(N_FACES):
                    observed_count += (
                        x[(face_a, value_a)]
                        * y[(face_b, value_b)]
                    )

        distribution_objective += (
            observed_count - expected_count
        ) ** 2

    one_hot_objective = 0

    for face in range(N_FACES):
        selected_values = sum(
            x[(face, value)]
            for value in VALUES_A
        )

        one_hot_objective += (selected_values - 1) ** 2

    for face in range(N_FACES):
        selected_values = sum(
            y[(face, value)]
            for value in VALUES_B
        )

        one_hot_objective += (selected_values - 1) ** 2

    return (
        distribution_objective
        + ONE_HOT_PENALTY * one_hot_objective
    )


def save_qubo_cache(qubo, offset):
    """Save the QUBO so later runs can skip symbolic compilation."""

    try:
        with open(QUBO_CACHE_FILE, "wb") as cache_file:
            pickle.dump(
                {
                    "signature": CACHE_SIGNATURE,
                    "qubo": qubo,
                    "offset": offset,
                },
                cache_file,
                protocol=pickle.HIGHEST_PROTOCOL,
            )

        print(f"Saved compiled QUBO cache: {QUBO_CACHE_FILE}")

    except Exception as cache_error:
        print("Could not save QUBO cache:", cache_error)


def prepare_qubo():
    """Load the cached QUBO or compile and cache a new one."""

    preparation_start = time.perf_counter()
    cached_qubo = load_cached_qubo()

    if cached_qubo is not None:
        qubo, offset = cached_qubo

        return {
            "qubo": qubo,
            "offset": offset,
            "compiled_model": None,
            "cache_used": True,
            "time": time.perf_counter() - preparation_start,
        }

    print("No matching cache found; building symbolic HUBO...")
    hamiltonian = build_symbolic_hamiltonian()

    print("Quadratizing HUBO with PyQUBO...")
    compiled_model = hamiltonian.compile(
        strength=REDUCTION_STRENGTH
    )

    qubo, offset = compiled_model.to_qubo()
    save_qubo_cache(qubo, offset)

    return {
        "qubo": qubo,
        "offset": offset,
        "compiled_model": compiled_model,
        "cache_used": False,
        "time": time.perf_counter() - preparation_start,
    }


# ======================================================================
# Constraint and result helpers
# ======================================================================

def build_one_hot_groups():
    groups = []

    for face in range(N_FACES):
        groups.append(
            [
                variable_a(face, value)
                for value in VALUES_A
            ]
        )

    for face in range(N_FACES):
        groups.append(
            [
                variable_b(face, value)
                for value in VALUES_B
            ]
        )

    return groups


def build_valid_initial_spin(seed):
    """Create a reproducible one-hot-valid initial state."""

    random_generator = random.Random(seed)
    initial_state = {}

    for face in range(N_FACES):
        selected_value = random_generator.choice(list(VALUES_A))

        for value in VALUES_A:
            initial_state[variable_a(face, value)] = int(
                value == selected_value
            )

    for face in range(N_FACES):
        selected_value = random_generator.choice(list(VALUES_B))

        for value in VALUES_B:
            initial_state[variable_b(face, value)] = int(
                value == selected_value
            )

    return initial_state


def decode_die(sample, prefix, allowed_values):
    faces = []
    valid = True
    face_selections = []

    for face in range(N_FACES):
        chosen = [
            value
            for value in allowed_values
            if int(
                sample.get(f"{prefix}_{face}_{value}", 0)
            ) == 1
        ]

        face_selections.append(chosen)

        if len(chosen) != 1:
            valid = False
            faces.append(None)
        else:
            faces.append(chosen[0])

    return faces, valid, face_selections


def resulting_distribution(die_a, die_b):
    counts = Counter()

    for face_a in die_a:
        for face_b in die_b:
            counts[face_a + face_b] += 1

    return dict(sorted(counts.items()))


def distribution_error(counts):
    maximum_sum = VMAX_A + VMAX_B

    return sum(
        (
            counts.get(total, 0)
            - TARGET.get(total, 0)
        ) ** 2
        for total in range(2, maximum_sum + 1)
    )


def one_hot_violations(sample):
    violations = 0

    for face in range(N_FACES):
        selected = sum(
            int(sample.get(variable_a(face, value), 0))
            for value in VALUES_A
        )

        if selected != 1:
            violations += 1

    for face in range(N_FACES):
        selected = sum(
            int(sample.get(variable_b(face, value), 0))
            for value in VALUES_B
        )

        if selected != 1:
            violations += 1

    return violations


def result_constraint_status(result):
    return getattr(result, "constraint", None)


def candidate_from_result(result, attempt_number, seed, result_index):
    sample = result.spin

    die_a, valid_a, selections_a = decode_die(
        sample,
        "A",
        VALUES_A,
    )

    die_b, valid_b, selections_b = decode_die(
        sample,
        "B",
        VALUES_B,
    )

    if not valid_a or not valid_b:
        print(
            f"Rejected attempt {attempt_number}, "
            f"result {result_index}: invalid one-hot decoding."
        )
        print("NEC constraint status:", result_constraint_status(result))
        print("Die A selections:", selections_a)
        print("Die B selections:", selections_b)
        return None

    counts = resulting_distribution(die_a, die_b)

    return {
        "result": result,
        "attempt": attempt_number,
        "seed": seed,
        "index": result_index,
        "die_a": die_a,
        "die_b": die_b,
        "counts": counts,
        "distribution_error": distribution_error(counts),
        "energy": float(result.energy),
        "one_hot_violations": one_hot_violations(sample),
        "constraint": result_constraint_status(result),
        "time": getattr(result, "time", None),
    }


def is_expected_sicherman_pair(die_a, die_b):
    expected_a = [1, 2, 2, 3, 3, 4]
    expected_b = [1, 3, 4, 5, 6, 8]

    return (
        sorted(die_a) == expected_a
        and sorted(die_b) == expected_b
    )


# ======================================================================
# Prepare model
# ======================================================================

print("=" * 70)
print("SICHERMAN DICE - NEC VECTOR ANNEALING")
print("=" * 70)

print("\nPreparing QUBO...")
prepared = prepare_qubo()

qubo = prepared["qubo"]
offset = prepared["offset"]
compiled_model = prepared["compiled_model"]
cache_used = prepared["cache_used"]
preparation_time = prepared["time"]

all_variable_names = set()

for variable_1, variable_2 in qubo:
    all_variable_names.add(variable_1)
    all_variable_names.add(variable_2)

auxiliary_variable_names = (
    all_variable_names - ORIGINAL_VARIABLE_NAMES
)

linear_terms = sum(
    1
    for variable_1, variable_2 in qubo
    if variable_1 == variable_2
)

quadratic_terms = sum(
    1
    for variable_1, variable_2 in qubo
    if variable_1 != variable_2
)

print("\nQUBO statistics")
print("-" * 70)
print(f"Original logical variables: {len(ORIGINAL_VARIABLE_NAMES)}")
print(f"Auxiliary variables:        {len(auxiliary_variable_names)}")
print(f"Total QUBO variables:       {len(all_variable_names)}")
print(f"Linear QUBO terms:          {linear_terms}")
print(f"Quadratic QUBO terms:       {quadratic_terms}")
print(f"Total nonzero QUBO terms:   {len(qubo)}")
print(f"QUBO offset:                {offset}")
print(f"QUBO cache used:            {cache_used}")
print(f"QUBO preparation time:      {preparation_time:.4f} seconds")

invalid_terms = [term for term in qubo if len(term) != 2]

if invalid_terms:
    raise RuntimeError("The compiled model contains invalid QUBO terms.")

print("\nQuadratization verification: PASSED")

one_hot_groups = build_one_hot_groups()
spin_list = sorted(all_variable_names)


# ======================================================================
# Run several fast attempts
# ======================================================================

print("\nPreparing NEC Vector Annealing...")
print(f"Base seed:                  {BASE_SEED}")
print(f"Maximum attempts:           {ARGS.attempts}")
print(f"Reads per attempt:          {ARGS.reads}")
print(f"Results per attempt:        {ARGS.results}")
print(f"Sweeps per read:            {ARGS.sweeps}")

best_candidate = None
exact_candidate = None
total_annealing_wall_time = 0.0
attempts_completed = 0

original_directory = os.getcwd()

with tempfile.TemporaryDirectory(
    prefix="sicherman_nec_va_"
) as nec_work_directory:
    try:
        os.chdir(nec_work_directory)

        va_model = VectorAnnealing.model(
            qubo,
            offset,
            onehot=one_hot_groups,
            spin_list=spin_list,
        )

        sampler = VectorAnnealing.sampler()

        for attempt_index in range(ARGS.attempts):
            attempt_number = attempt_index + 1
            attempt_seed = BASE_SEED + attempt_index
            initial_spin = build_valid_initial_spin(attempt_seed)

            print(
                f"\nAttempt {attempt_number}/{ARGS.attempts} "
                f"using seed {attempt_seed}..."
            )

            attempt_start = time.perf_counter()

            results = sampler.sample(
                va_model,
                num_reads=ARGS.reads,
                num_results=ARGS.results,
                num_sweeps=ARGS.sweeps,
                num_threads=NUM_THREADS,
                beta_range=BETA_RANGE,
                seed=attempt_seed,
                init_spin=initial_spin,
            )

            attempt_wall_time = time.perf_counter() - attempt_start
            total_annealing_wall_time += attempt_wall_time
            attempts_completed += 1

            if not results:
                print("NEC returned no results for this attempt.")
                continue

            sorted_results = sorted(
                results,
                key=lambda result: float(result.energy),
            )

            attempt_best = None

            for result_index, result in enumerate(sorted_results):
                candidate = candidate_from_result(
                    result,
                    attempt_number,
                    attempt_seed,
                    result_index,
                )

                if candidate is None:
                    continue

                if (
                    attempt_best is None
                    or candidate["distribution_error"]
                    < attempt_best["distribution_error"]
                ):
                    attempt_best = candidate

                if (
                    best_candidate is None
                    or candidate["distribution_error"]
                    < best_candidate["distribution_error"]
                ):
                    best_candidate = candidate

                if candidate["distribution_error"] == 0:
                    exact_candidate = candidate
                    break

            if attempt_best is not None:
                print(
                    f"Attempt error:              "
                    f"{attempt_best['distribution_error']}"
                )
                print(
                    f"Attempt wall time:          "
                    f"{attempt_wall_time:.4f} seconds"
                )

            if exact_candidate is not None:
                print("Exact solution found; stopping additional attempts.")
                break

    finally:
        os.chdir(original_directory)


# ======================================================================
# Print best result
# ======================================================================

print("\n" + "=" * 70)
print("RESULT")
print("=" * 70)

if best_candidate is None:
    print("No returned sample satisfied the one-hot constraints.")
    sys.exit(1)

selected_candidate = (
    exact_candidate
    if exact_candidate is not None
    else best_candidate
)

selected_result = selected_candidate["result"]
die_a = selected_candidate["die_a"]
die_b = selected_candidate["die_b"]
counts = selected_candidate["counts"]
match = selected_candidate["distribution_error"] == 0

print(f"Attempt number:              {selected_candidate['attempt']}")
print(f"Seed:                        {selected_candidate['seed']}")
print(f"Result number:               {selected_candidate['index']}")
print(f"NEC-reported QUBO energy:    {selected_candidate['energy']}")
print(
    f"Distribution error:         "
    f"{selected_candidate['distribution_error']}"
)
print(
    f"One-hot violations:         "
    f"{selected_candidate['one_hot_violations']}"
)
print(
    f"NEC constraint status:      "
    f"{selected_candidate['constraint']}"
)
print(f"Attempts completed:          {attempts_completed}")
print(
    f"Total annealing wall time:  "
    f"{total_annealing_wall_time:.4f} seconds"
)

if selected_candidate["time"] is not None:
    print(
        f"NEC-reported solve time:    "
        f"{selected_candidate['time']} seconds"
    )

print(f"\nDie A faces: {sorted(die_a)}")
print(f"Die B faces: {sorted(die_b)}")

print("\nSum distribution")
print("-" * 70)
print("Sum | Obtained | Target | Difference")
print("-" * 70)

for total in range(2, 13):
    obtained = counts.get(total, 0)
    expected = TARGET.get(total, 0)

    print(
        f"{total:>3} | "
        f"{obtained:>8} | "
        f"{expected:>6} | "
        f"{obtained - expected:>10}"
    )

outside_target = {
    total: count
    for total, count in counts.items()
    if total < 2 or total > 12
}

print("\nTarget distribution:")
print(dict(sorted(TARGET.items())))

print("\nObtained distribution:")
print(counts)

print(f"\nExact distribution match: {match}")

if outside_target:
    print("Unexpected sums outside 2 through 12:", outside_target)


# ======================================================================
# Optional PyQUBO diagnostic
# ======================================================================

if compiled_model is None:
    print(
        "PyQUBO diagnostic decoding: SKIPPED "
        "(QUBO was loaded from cache)"
    )

else:
    try:
        decoded_sample = compiled_model.decode_sample(
            selected_result.spin,
            vartype="BINARY",
        )

        print(f"PyQUBO decoded energy:       {decoded_sample.energy}")
        print(
            "Broken PyQUBO constraints:   ",
            decoded_sample.constraints(only_broken=True),
        )

    except Exception as error:
        print("PyQUBO diagnostic decoding unavailable:", error)


# ======================================================================
# Final interpretation
# ======================================================================

print("\n" + "=" * 70)

if not match:
    print("No exact target-distribution solution was found.")
    print(
        "Increase --attempts first. Increase --sweeps only if additional "
        "seeds still do not reach energy 0."
    )
    sys.exit(2)

if not is_expected_sicherman_pair(die_a, die_b):
    print(
        "An exact distribution match was found, but it was not "
        "the expected nontrivial Sicherman pair."
    )
    sys.exit(3)

print("NONTRIVIAL SICHERMAN SOLUTION FOUND AND VERIFIED.")

print("=" * 70)
